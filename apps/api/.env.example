# Sunucu
PORT=3000
NODE_ENV=development

# SQLite veritabanı dosyası (apps/api klasörüne göre)
DATABASE_URL=file:./data/karar.db

# Yüklenen görsellerin klasörü ve dışarıdan görünen kök adres
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:3000

# Çerezli istek kabul edilen kaynaklar (site ve admin paneli), virgülle ayrılır
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Oturum süresi (gün)
SESSION_TTL_DAYS=7

# Ana kullanıcı (owner). İlk `pnpm db:seed` çalıştırmasında, hiç kullanıcı yoksa oluşturulur.
# Şifre en az 10 karakter olmalı. İlk girişten sonra panelden değiştirin.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
